{
  "modules": {
    "type": "object",
    "description": "模块开关",
    "hint": "每个模块可单独开关；关掉的模块不会注册任何定时任务或指令。",
    "items": {
      "shift_reminder": {
        "type": "bool",
        "description": "基建换班提醒",
        "hint": "按下面的三班定义注册定时提醒，在每班换班前若干分钟推送。需要先用 /ak bind 绑定提醒目标；未绑定时不会推送，只在日志里留一条警告。",
        "default": true
      }
    }
  },
  "shift_reminder": {
    "type": "object",
    "description": "基建换班提醒模块",
    "hint": "三段时长必须正好合计 24 小时、并且首尾相接（上一班的结束时刻 = 下一班的开始时刻）。换班提醒在注册定时任务时会按这条校验，不合法会明确报错并拒绝注册，不会静默少排一班。班次名称随你习惯叫。",
    "default": {
      "shift_1_name": "早班",
      "shift_1_start": "08:00",
      "shift_1_hours": 12,
      "shift_2_name": "晚班",
      "shift_2_start": "20:00",
      "shift_2_hours": 6,
      "shift_3_name": "夜班",
      "shift_3_start": "02:00",
      "shift_3_hours": 6,
      "lead_minutes": 10,
      "timezone": "Asia/Shanghai"
    },
    "items": {
      "shift_1_name": {
        "type": "string",
        "description": "第一班名称",
        "hint": "提醒消息里显示的名字，例如「早班」。",
        "default": "早班"
      },
      "shift_1_start": {
        "type": "string",
        "description": "第一班开始时刻",
        "hint": "24 小时制 HH:MM，例如 08:00。",
        "default": "08:00"
      },
      "shift_1_hours": {
        "type": "int",
        "description": "第一班时长（小时）",
        "hint": "这一班持续多少小时，例如 12。",
        "default": 12
      },
      "shift_2_name": {
        "type": "string",
        "description": "第二班名称",
        "hint": "提醒消息里显示的名字，例如「晚班」。",
        "default": "晚班"
      },
      "shift_2_start": {
        "type": "string",
        "description": "第二班开始时刻",
        "hint": "24 小时制 HH:MM，例如 20:00。",
        "default": "20:00"
      },
      "shift_2_hours": {
        "type": "int",
        "description": "第二班时长（小时）",
        "hint": "这一班持续多少小时，例如 6。",
        "default": 6
      },
      "shift_3_name": {
        "type": "string",
        "description": "第三班名称",
        "hint": "提醒消息里显示的名字，例如「夜班」。",
        "default": "夜班"
      },
      "shift_3_start": {
        "type": "string",
        "description": "第三班开始时刻",
        "hint": "24 小时制 HH:MM，例如 02:00。跨天写真实时刻即可，不需要写 26:00。",
        "default": "02:00"
      },
      "shift_3_hours": {
        "type": "int",
        "description": "第三班时长（小时）",
        "hint": "这一班持续多少小时，例如 6。",
        "default": 6
      },
      "lead_minutes": {
        "type": "int",
        "description": "提前量（分钟）",
        "hint": "换班时刻提前多久推送提醒。默认 10 分钟，够从手头的事里抽身开游戏。",
        "default": 10
      },
      "timezone": {
        "type": "string",
        "description": "时区",
        "hint": "提醒按这个时区的时刻触发。必须写 IANA 时区名，例如 Asia/Shanghai、Asia/Tokyo、UTC；写错会在加载插件时明确报错，不会静默按别的时区跑。留空则使用默认值 Asia/Shanghai。",
        "default": "Asia/Shanghai"
      }
    }
  }
}
